---
import Base from "../layouts/Base.astro";
import ShowcaseBack from "../components/ShowcaseBack.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Clientes from "../components/Clientes.astro";
import Servicios from "../components/Servicios.astro";
import Proceso from "../components/Proceso.astro";
import Resultados from "../components/Resultados.astro";
import Rubros from "../components/Rubros.astro";
import Testimonios from "../components/Testimonios.astro";
import Faq from "../components/Faq.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---
<Base>
  <ShowcaseBack />
  <Nav />
  <main id="contenido">
    <Hero />
    <Clientes />
    <Servicios />
    <Proceso />
    <Resultados />
    <Rubros />
    <Testimonios />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Base>

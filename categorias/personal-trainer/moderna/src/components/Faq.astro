---
import content from "../data/content.json";
import WhatsAppButton from "./WhatsAppButton.astro";
const { faq, hero } = content;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((f) => ({
    "@type": "Question",
    name: f.pregunta,
    acceptedAnswer: { "@type": "Answer", text: f.respuesta },
  })),
};
---
<section class="section faq" id="faq">
  <div class="container faq__grid">
    <div class="faq__head">
      <h2 class="section__title" data-split>{faq.titulo}</h2>
      <p class="faq__hint" data-reveal>¿Otra duda? Pregúntame directo.</p>
      <div data-reveal style="--d:80ms">
        <WhatsAppButton etiqueta="Escríbeme" texto={hero.mensajeWhatsapp} origen="faq" variante="line" />
      </div>
    </div>
    <div class="faq__list">
      {faq.items.map((f, i) => (
        <details class="qa" data-reveal style={`--d:${i * 70}ms`}>
          <summary>
            <span class="qa__n">{String(i + 1).padStart(2, "0")}</span>
            <span class="qa__q">{f.pregunta}</span>
            <span class="qa__plus" aria-hidden="true"></span>
          </summary>
          <p>{f.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

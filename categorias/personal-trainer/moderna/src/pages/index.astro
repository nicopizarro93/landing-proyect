---
import Base from "../layouts/Base.astro";
import ShowcaseBack from "../components/ShowcaseBack.astro";
import ProgressRail from "../components/ProgressRail.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bento from "../components/Bento.astro";
import Servicios from "../components/Servicios.astro";
import Sobre from "../components/Sobre.astro";
import Proceso from "../components/Proceso.astro";
import Planes from "../components/Planes.astro";
import Testimonios from "../components/Testimonios.astro";
import Faq from "../components/Faq.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---
<Base>
  <ProgressRail />
  <ShowcaseBack />
  <Nav />
  <main id="contenido">
    <Hero />
    <Bento />
    <Servicios />
    <Sobre />
    <Proceso />
    <Planes />
    <Testimonios />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Base>

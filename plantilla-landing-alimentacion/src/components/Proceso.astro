---
import content from "../data/content.json";
const { proceso } = content;
---
<section class="section flow" id="proceso">
  <div class="container flow__grid">
    <h2 class="section__title" data-reveal>{proceso.titulo}</h2>
    <ol class="flow__list">
      {proceso.pasos.map((p, i) => (
        <li class="flow__step">
          <span class="flow__dot" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{p.titulo}</h3>
            <p>{p.descripcion}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

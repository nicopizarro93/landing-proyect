---
import Base from "../layouts/Base.astro";
import ShowcaseBack from "../components/ShowcaseBack.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Confianza from "../components/Confianza.astro";
import Servicios from "../components/Servicios.astro";
import Menu from "../components/Menu.astro";
import Cotizador from "../components/Cotizador.astro";
import Proceso from "../components/Proceso.astro";
import Cifras from "../components/Cifras.astro";
import Testimonios from "../components/Testimonios.astro";
import Cobertura from "../components/Cobertura.astro";
import Faq from "../components/Faq.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
---
<Base>
  <ShowcaseBack />
  <Nav />
  <main id="contenido">
    <Hero />
    <Confianza />
    <Servicios />
    <Menu />
    <Cotizador />
    <Proceso />
    <Cifras />
    <Testimonios />
    <Cobertura />
    <Faq />
    <Contacto />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>

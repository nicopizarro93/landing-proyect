---
import Base from "../layouts/Base.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import Kinetico from "../components/Kinetico.astro";
import Servicios from "../components/Servicios.astro";
import Sobre from "../components/Sobre.astro";
import Proceso from "../components/Proceso.astro";
import Planes from "../components/Planes.astro";
import Testimonios from "../components/Testimonios.astro";
import Faq from "../components/Faq.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
---
<Base>
  <ScrollProgress />
  <Nav />
  <Hero />
  <main>
    <Marquee />
    <Stats />
    <Kinetico />
    <Servicios />
    <Sobre />
    <Proceso />
    <Planes />
    <Testimonios />
    <Faq />
